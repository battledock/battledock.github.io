<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Plan de Carrière — Battle Dock</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0/dist/umd/supabase.min.js"></script>

    <style>
        :root {
            --bg-white: #ffffff;
            --surface-light: #f8fafc;
            --border-color: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --accent-green: #bef264;
        }

        * { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
            -webkit-tap-highlight-color: transparent;
        }
        
        body { 
            background-color: #ffffff; 
            color: var(--text-main);
            font-family: 'Urbanist', sans-serif;
            padding-bottom: 40px;
            padding-top: 60px;
        }
        
        .container {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
            padding: 16px;
        }

        /* TITRE */
        .page-title-area {
            padding: 20px 0 30px 0;
        }
        h1 { 
            font-size: 32px; 
            font-weight: 900; 
            text-transform: uppercase; 
            letter-spacing: -0.5px;
            line-height: 1.1;
        }
        .subtitle { 
            font-size: 15px; 
            color: var(--text-muted); 
            font-family: 'Inter', sans-serif; 
            margin-top: 8px; 
        }

        /* TIMELINE / LISTE DES NIVEAUX */
        .timeline {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-top: 10px;
        }

        .level-row {
            background-color: var(--surface-light);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
        }

        /* État si le niveau est dépassé ou actuel */
        .level-row.unlocked {
            border-color: var(--text-main);
        }

        .level-number {
            font-size: 24px;
            font-weight: 900;
            color: var(--text-main);
            min-width: 70px;
        }
        
        .level-row.locked .level-number {
            color: var(--text-muted);
        }

        .level-details {
            flex-grow: 1;
            padding-left: 10px;
        }

        .level-title {
            font-size: 16px;
            font-weight: 800;
            color: var(--text-main);
        }

        .level-reward {
            font-size: 13px;
            color: var(--text-muted);
            font-family: 'Inter', sans-serif;
            margin-top: 2px;
        }

        /* BADGE CURRENT LEVEL */
        .current-badge {
            background: var(--accent-green);
            color: var(--text-main);
            font-size: 10px;
            font-weight: 900;
            padding: 4px 8px;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: none;
        }

        /* BOUTON RETOUR FIXE */
        .btn-back { 
            position: fixed; 
            top: 0; 
            left: 0; 
            right: 0;
            background: #ffffff; 
            border-bottom: 1px solid var(--border-color);
            color: var(--text-main); 
            padding: 14px 16px; 
            cursor: pointer; 
            font-family: 'Inter', sans-serif; 
            font-size: 14px; 
            font-weight: 700;
            text-align: left;
            z-index: 100;
            border-top: none;
            border-left: none;
            border-right: none;
        }
    </style>
</head>
<body>

    <button class="btn-back" onclick="window.location.href='game.html'">← RETOUR AU DASHBOARD</button>

    <div class="container">
        
        <div class="page-title-area">
            <h1>Plan de Carrière</h1>
            <div class="subtitle">Progression hiérarchique et récompenses d'échelon.</div>
        </div>

        <div class="timeline" id="timelineContainer">
            </div>

    </div>

    <script>
        const supabaseUrl = 'https://drtsuhnbclhmgfjiykap.supabase.co';
        const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRydHN1aG5iY2xobWdmaml5a2FwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg4NDIzODksImV4cCI6MjA5NDQxODM4OX0.68cvRa8xhrSDt2nnEEp7pagL7NT5ugRtOhKLGX2CQJg';
        const { createClient } = supabase;
        const supabaseClient = createClient(supabaseUrl, supabaseKey);

        const userId = localStorage.getItem('userId');
        if (!userId) window.location.href = 'index.html';

        // Configuration des déblocages majeurs visibles dans la liste
        const milestones = {
            1: { title: "Docker Occasionnel", reward: "Accès de base au hangar de tri congelé (+15€)" },
            3: { title: "Docker Syndiqué", reward: "Débloque le tri de conteneurs industriels (+45€)" },
            10: { title: "Chef d'Équipe au Sol", reward: "Bonus passif permanent de +5% sur les paies" },
            25: { title: "Contremaître des Quais", reward: "Déblocage de la Zone B & Casino Clandestin" },
            50: { title: "Directeur de Terminal", reward: "Licence d'exploitation exclusive" },
            75: { title: "Superviseur Régional", reward: "Accès à l'Élite Logistique Mondiale" },
            100: { title: "Légende du Battle Dock", reward: "Contrôle absolu des flux portuaires" }
        };

        loadCareerProgression();

        async function loadCareerProgression() {
            try {
                // Récupération de l'XP actuelle
                const { data } = await supabaseClient.from('game_progress').select('xp').eq('user_id', userId).single();
                
                let playerLevel = 1;
                if (data && data.xp) {
                    playerLevel = Math.floor(data.xp / 50) + 1;
                }

                const container = document.getElementById('timelineContainer');
                container.innerHTML = ""; // Vider

                // Génération intelligente de la liste jusqu'au niveau 100
                for (let i = 1; i <= 100; i++) {
                    // Pour ne pas surcharger le téléphone, on affiche les premiers niveaux, puis uniquement les paliers clés
                    if (i <= 5 || milestones[i] || i === playerLevel) {
                        
                        const isUnlocked = i <= playerLevel;
                        const isCurrent = i === playerLevel;
                        
                        // Infos textuelles par défaut ou spécifiques
                        const title = milestones[i] ? milestones[i].title : `Échelon Technique ${i}`;
                        const reward = milestones[i] ? milestones[i].reward : `Optimisation des compétences (+${i * 2}€ potentiels)`;

                        const row = document.createElement('div');
                        row.className = `level-row ${isUnlocked ? 'unlocked' : 'locked'}`;
                        
                        row.innerHTML = `
                            <div class="level-number">NIV.${i}</div>
                            <div class="level-details">
                                <div class="level-title">${title}</div>
                                <div class="level-reward">${reward}</div>
                            </div>
                            <div class="current-badge" style="display: ${isCurrent ? 'block' : 'none'}">Actuel</div>
                        `;
                        
                        container.appendChild(row);
                    }
                }
            } catch(e) {
                console.error("Erreur lors de la création de la frise de carrière :", e);
            }
        }
    </script>
</body>
</html>
